<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QLTKB</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: #f4f6fa;
            color: #263445;
        }

        .topbar {
            height: 64px;
            background: #2875bb;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.12);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            background: white;
            color: #2875bb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            font-weight: bold;
        }

        .brand small {
            display: block;
            font-size: 11px;
            font-weight: normal;
            letter-spacing: 0.8px;
            opacity: 0.9;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 14px;
        }

        .auth-link {
            display: inline-block;
            padding: 7px 14px;
            border: 1px solid white;
            border-radius: 6px;
            color: white;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: 0.2s;
        }

        .auth-link:hover {
            background: white;
            color: #2875bb;
        }

        .register-link {
            background: white;
            color: #2875bb;
            font-weight: bold;
        }

        .register-link:hover {
            background: #e8f2ff;
        }

        .main-layout {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background: #202832;
            color: #d8e0e9;
            padding: 16px 10px;
        }

        .menu-title {
            color: #7dbdff;
            font-size: 11px;
            font-weight: 700;
            padding: 10px 12px 14px;
            letter-spacing: 0.8px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 14px;
            margin-bottom: 4px;
            border-radius: 6px;
            color: #cbd5e1;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.15s ease-in-out;
        }

        .menu-item:hover {
            background: #334155;
            color: white;
        }

        .menu-item.active {
            background: #2875bb;
            color: white;
            font-weight: 600;
        }

        .content {
            flex: 1;
            min-width: 0;
            padding: 24px 30px;
        }

        /* Đồng bộ giao diện Card & Table cho toàn hệ thống */
        .app-card {
            background: white;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            margin-bottom: 20px;
        }

        .app-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .app-header h1, .app-header h2 {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            color: #1e293b;
        }

        .app-header p {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 13px;
        }

        .table-custom {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .table-custom th {
            background: #f8fafc;
            color: #475569;
            font-weight: 600;
            padding: 12px 14px;
            border-bottom: 2px solid #e2e8f0;
            text-align: left;
            white-space: nowrap;
        }

        .table-custom td {
            padding: 12px 14px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            color: #334155;
        }

        .table-custom tr:hover td {
            background-color: #f8fafc;
        }

        .badge-sub {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-sub-success {
            background: #dcfce7;
            color: #15803d;
        }

        .badge-sub-danger {
            background: #fee2e2;
            color: #b91c1c;
        }

        .badge-sub-info {
            background: #e0f2fe;
            color: #0369a1;
        }

        .footer {
            padding: 24px 0 10px;
            color: #94a3b8;
            font-size: 12px;
            text-align: center;
        }
    </style>
</head>

<body>
    <header class="topbar">
        <div class="brand">
            <div class="brand-icon">TKB</div>
            <div>
                HỆ THỐNG QLTKB
                <small>QUẢN LÝ THỜI KHÓA BIỂU</small>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="text-white me-2" style="font-size: 14px;">
                    Xin chào, <strong>@(User.Identity.Name ?? "Người dùng")</strong>
                </span>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-light">
                        Đăng xuất
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="auth-link">
                    Đăng nhập
                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="auth-link register-link">
                    Đăng ký
                </a>
            }
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <div class="menu-title">DANH MỤC QUẢN LÝ</div>

            @{
                var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            }

            <a href="/" class="menu-item @(currentCtrl == "Home" ? "active" : "")">
                Trang chủ
            </a>

            <a asp-controller="TaiKhoan"
               asp-action="Index"
               class="menu-item @(currentCtrl == "TaiKhoan" ? "active" : "")">
                Quản lý tài khoản
            </a>

            <a asp-controller="HocPhan"
               asp-action="Index"
               class="menu-item @(currentCtrl == "HocPhan" ? "active" : "")">
                Quản lý học phần
            </a>

            <a asp-controller="GiangVien"
               asp-action="Index"
               class="menu-item @(currentCtrl == "GiangVien" ? "active" : "")">
                Quản lý Giảng viên
            </a>

            <a asp-controller="SinhVien"
               asp-action="Index"
               class="menu-item @(currentCtrl == "SinhVien" ? "active" : "")">
                Quản lý Sinh viên
            </a>

            <a asp-controller="PhongHoc"
               asp-action="Index"
               class="menu-item @(currentCtrl == "PhongHoc" ? "active" : "")">
                Quản lý Phòng học
            </a>

            <div class="menu-title" style="margin-top: 15px;">THỜI KHÓA BIỂU</div>

            <a href="#" class="menu-item">
                Quản lý học kỳ
            </a>

            <a href="#" class="menu-item">
                Lớp học phần
            </a>

            <a href="#" class="menu-item">
                Thời khóa biểu
            </a>

            <a href="#" class="menu-item">
                Xuất Excel
            </a>
        </aside>

        <main class="content">
            @RenderBody()

            <div class="footer">
                Hệ thống quản lý thời khóa biểu &middot; QLTKB
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
