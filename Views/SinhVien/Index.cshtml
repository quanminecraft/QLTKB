@model IEnumerable<QLTKB.Models.SinhVien>

@{
    ViewData["Title"] = "Quản lý sinh viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-card">
    <div class="app-header">
        <div>
            <h2>Quản lý sinh viên</h2>
            <p>Danh sách hồ sơ sinh viên trong hệ thống</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Thêm sinh viên
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3 text-muted" style="font-size: 13px;">
        <span>Tổng số sinh viên: <strong class="text-dark">@Model.Count()</strong></span>
    </div>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Mã SV</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Lớp</th>
                    <th>Ngành</th>
                    <th>Khóa học</th>
                    <th>Số điện thoại</th>
                    <th style="text-align: right;">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var sv in Model)
                    {
                        <tr>
                            <td><strong class="text-primary">@sv.MaSinhVien</strong></td>
                            <td class="fw-semibold">@(sv.TaiKhoan?.HoTen ?? "—")</td>
                            <td>@(sv.TaiKhoan?.Email ?? "—")</td>
                            <td><span class="badge bg-light text-dark border">@(sv.Lop ?? "—")</span></td>
                            <td>@(sv.Nganh ?? "—")</td>
                            <td class="text-muted">@(sv.KhoaHoc ?? "—")</td>
                            <td class="text-muted">@(sv.SoDienThoai ?? "—")</td>
                            <td style="text-align: right; white-space: nowrap;">
                                <a asp-action="Edit"
                                   asp-route-id="@sv.SinhVienID"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    Sửa
                                </a>
                                <form asp-action="Delete"
                                      asp-route-id="@sv.SinhVienID"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn khóa tài khoản sinh viên này không?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Khóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            Chưa có dữ liệu sinh viên trong hệ thống.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
