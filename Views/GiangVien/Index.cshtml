@model IEnumerable<QLTKB.Models.GiangVien>

@{
    ViewData["Title"] = "Quản lý giảng viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-card">
    <div class="app-header">
        <div>
            <h2>Quản lý giảng viên</h2>
            <p>Danh sách hồ sơ giảng viên và cán bộ giảng dạy</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Thêm giảng viên
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3 text-muted" style="font-size: 13px;">
        <span>Tổng số giảng viên: <strong class="text-dark">@Model.Count()</strong></span>
    </div>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Mã GV</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Học vị</th>
                    <th>Khoa</th>
                    <th>Bộ môn</th>
                    <th>Số điện thoại</th>
                    <th style="text-align: right;">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var gv in Model)
                    {
                        <tr>
                            <td><strong class="text-primary">@gv.MaGiangVien</strong></td>
                            <td class="fw-semibold">@(gv.TaiKhoan?.HoTen ?? "—")</td>
                            <td>@(gv.TaiKhoan?.Email ?? "—")</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(string.IsNullOrEmpty(gv.HocVi) ? "—" : gv.HocVi)
                                </span>
                            </td>
                            <td>@(gv.Khoa ?? "—")</td>
                            <td>@(gv.BoMon ?? "—")</td>
                            <td class="text-muted">@(gv.SoDienThoai ?? "—")</td>
                            <td style="text-align: right; white-space: nowrap;">
                                <a asp-action="Edit"
                                   asp-route-id="@gv.GiangVienID"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    Sửa
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@gv.GiangVienID"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn khóa tài khoản giảng viên này không?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Khóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            Chưa có dữ liệu giảng viên trong hệ thống.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
