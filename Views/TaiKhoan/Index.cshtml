@model IEnumerable<QLTKB.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản lý tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-card">
    <div class="app-header">
        <div>
            <h2>Quản lý tài khoản</h2>
            <p>Danh sách người dùng và phân quyền truy cập hệ thống</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Thêm tài khoản mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3 text-muted" style="font-size: 13px;">
        <span>Tổng số tài khoản: <strong class="text-dark">@Model.Count()</strong></span>
    </div>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Họ và tên</th>
                    <th>Tên đăng nhập</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th style="text-align: right;">Thao tác</th>
                </tr>
            </thead>
            
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var tk in Model)
                    {
                        <tr>
                            <td class="text-muted">#@tk.TaiKhoanID</td>
                            <td class="fw-semibold">@tk.HoTen</td>
                            <td><span class="badge-sub badge-sub-info">@tk.TenDangNhap</span></td>
                            <td>@tk.Email</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(tk.VaiTro?.TenVaiTro ?? "Chưa xác định")
                                </span>
                            </td>
                            <td>
                                @if (tk.TrangThai)
                                {
                                    <span class="badge-sub badge-sub-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge-sub badge-sub-danger">Đã khóa</span>
                                }
                            </td>
                            <td class="text-muted" style="font-size: 13px;">@tk.NgayTao.ToString("dd/MM/yyyy")</td>
                            <td style="text-align: right; white-space: nowrap;">
                                <a asp-action="Edit" asp-route-id="@tk.TaiKhoanID"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    Sửa
                                </a>

                                @if (tk.TrangThai)
                                {
                                    <a asp-action="Delete" asp-route-id="@tk.TaiKhoanID"
                                       class="btn btn-sm btn-outline-danger">
                                        Khóa
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            Chưa có tài khoản nào trong hệ thống.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
