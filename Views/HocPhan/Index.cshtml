@model IEnumerable<QLTKB.Models.HocPhan>

@{
    ViewData["Title"] = "Quản lý học phần";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-card">
    <div class="app-header">
        <div>
            <h2>Quản lý học phần</h2>
            <p>Danh sách học phần trong chương trình đào tạo</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Thêm học phần mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3 text-muted" style="font-size: 13px;">
        <span>Tổng số học phần: <strong class="text-dark">@Model.Count()</strong></span>
    </div>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Mã học phần</th>
                    <th>Tên học phần</th>
                    <th class="text-center">Số TC</th>
                    <th class="text-center">LT / TH (tiết)</th>
                    <th>Mô tả</th>
                    <th>Trạng thái</th>
                    <th style="text-align: right;">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var hp in Model)
                    {
                        <tr>
                            <td><strong class="text-primary">@hp.MaHocPhan</strong></td>
                            <td class="fw-semibold">@hp.TenHocPhan</td>
                            <td class="text-center">@hp.SoTinChi</td>
                            <td class="text-center text-muted">@hp.SoTietLyThuyet / @hp.SoTietThucHanh</td>
                            <td class="text-muted" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@hp.MoTa">
                                @(string.IsNullOrEmpty(hp.MoTa) ? "—" : hp.MoTa)
                            </td>
                            <td>
                                @if (hp.TrangThai)
                                {
                                    <span class="badge-sub badge-sub-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge-sub badge-sub-danger">Đã khóa</span>
                                }
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                <a asp-action="Edit"
                                   asp-route-id="@hp.HocPhanID"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    Sửa
                                </a>

                                @if (hp.TrangThai)
                                {
                                    <a asp-action="Delete"
                                       asp-route-id="@hp.HocPhanID"
                                       class="btn btn-sm btn-outline-danger">
                                        Khóa
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            Chưa có dữ liệu học phần trong hệ thống.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
